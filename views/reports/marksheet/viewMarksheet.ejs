<%- include("../../partials/header.ejs")%>

<div class="print-form">

    <form id="marksheetForm" method="POST" target="_blank">

        <h5 style="text-align: center; margin-bottom:20px">
            Marksheet Print
        </h5>

        <h4 style="text-align: center; margin-bottom:20px">
            Enter Roll nos. of the candidates
        </h4>

        <% if (typeof error_message !== 'undefined') { %>
            <p style="text-align: center; color:red">
                <%= error_message %>
            </p>
        <% } %>

        <div class="form-row">
            <div class="form-row-element">
                <label class="student-label" for="m_start_roll">
                    <strong>Starting No.</strong>
                </label>

                <input
                    type="text"
                    id="m_start_roll"
                    name="m_start_roll"
                    required
                    autocomplete="off"
                >
            </div>

            <div class="form-row-element">
                <label class="student-label" for="m_end_roll">
                    <strong>Ending No.</strong>
                </label>

                <input
                    type="text"
                    id="m_end_roll"
                    name="m_end_roll"
                    required
                    autocomplete="off"
                >
            </div>
        </div>

        <div class="button-submit">
            <button
                type="submit"
                class="btn btn-primary"
                onclick="this.form.action='/printMarksheetLaser'"
            >
                Print
            </button>
        </div>

        <div class="button-submit">
            <button
                type="submit"
                class="btn btn-primary"
                onclick="this.form.action='/printMarksheetLaserReal'"
            >
                Print Laser
            </button>
        </div>

    </form>

    <div class="button-submit">
        <a
            href="/home"
            style="width:10vw; margin-left:0px"
            class="btn btn-primary"
        >
            Exit
        </a>
    </div>

</div>

<%- include("../../partials/footer.ejs")%>