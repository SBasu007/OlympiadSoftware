<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Print Document in cm</title>
    <style>
        /* Set the paper size using cm */
        @page {
            size: 21.20cm 20.50cm;
            margin: 0;
        }

        .text1 {
    position: absolute;
    top:  6.6cm; 
    left: 6.3cm;
}
.text2 {
    position: absolute;
    top: 7.4cm; /* Increased by 0.1cm more */
    left: 5.3cm;
}
.text3 {
    position: absolute;
    top: 8.3cm; /* Increased by 0.1cm more */
    left: 3.5cm;
}
.text4 {
    position: absolute;
    top: 8.3cm; /* Matches .text3 to maintain box levels */
    left: 13.3cm;
}
.text5 {
    position: absolute;
    top: 9.05cm; /* Increased by 0.1cm */
    left: 3.8cm;
}
.text6 {
    position: absolute;
    top: 10.0cm; /* Increased by 0.1cm */
    left: 4.9cm;
}
.text7 {
    position: absolute;
    top: 10.85cm; /* Increased by 0.1cm */
    left: 3.8cm;
}

.text8 {
    position: absolute;
    top: 12.3cm; /* was 11cm */
    left: 5.5cm;
    font-weight: bold;
}
.text9 {
    position: absolute;
    top: 13.5cm; /* was 11.7cm */
    left: 3.0cm;
}
.text10 {
    position: absolute;
    top: 13.5cm; /* was 11.7cm */
    left: 7.4cm;
}
.text11 {
    position: absolute;
    top: 13.5cm; /* was 11.7cm */
    left: 11.8cm;
}
.text12 {
    position: absolute;
    top: 14.7cm; /* was 12.4cm */
    left: 3.0cm;
}
.text15 {
    position: absolute;
    top: 14.7cm; /* was 12.4cm */
    left: 7.4cm;
}
.text13 {
    position: absolute;
    top: 14.7cm; /* was 12.4cm */
    left: 11.8cm;
}
.text14 {
    position: absolute;
    top: 18.6cm; /* was 14cm */
    left: 15.2cm;
}

        .font{
            font-family: "Courier New", monospace;
            font-size: 16px;
        }
        /* Modal styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: white;
            padding: 20px;
            border: 1px solid #888;
            width: 300px;
            text-align: center;
            border-radius: 10px;
        }

        .modal-content button {
            margin: 10px;
            padding: 10px 20px;
        }

        .modal-content button:hover {
            cursor: pointer;
            background-color: #ccc;
        }
    </style>
</head>
<body>

<div class="text1 font" id="text-content1"></div>
<div class="text2 font" id="text-content2"></div>
<div class="text3 font" id="text-content3"></div>
<div class="text4 font" id="text-content4"></div>
<div class="text5 font" id="text-content5"></div>
<div class="text6 font" id="text-content6"></div>
<div class="text7 font" id="text-content7"></div>
<div class="text8 font" id="text-content8"></div>
<div class="text9 font" id="text-content9"></div>
<div class="text10 font" id="text-content10"></div>
<div class="text11 font" id="text-content11"></div>
<div class="text12 font" id="text-content12"></div>
<div class="text13 font" id="text-content13"></div>
<div class="text14 font" id="text-content14"></div>
<div class="text15 font" id="text-content15"></div>
<div class="text16 font" id="text-content16"></div>

<!-- Modal -->
<div id="myModal" class="modal">
    <div class="modal-content">
        <p>Do you want to print the next document?</p>
        <button id="yesBtn">Yes</button>
        <button id="noBtn">No</button>
    </div>
</div>

<textarea id="studentData" style="display:none;">
<%- JSON.stringify(display) %>
</textarea>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const studentData =
        document.getElementById('studentData').value;

    const students = JSON.parse(studentData);

    let currentDocIndex = 0;

    function openModal() {

        return new Promise((resolve) => {

            const modal =
                document.getElementById("myModal");

            const yesBtn =
                document.getElementById("yesBtn");

            const noBtn =
                document.getElementById("noBtn");

            modal.style.display = "flex";

            yesBtn.onclick = () => {
                modal.style.display = "none";
                resolve(true);
            };

            noBtn.onclick = () => {
                modal.style.display = "none";
                resolve(false);
            };

        });

    }

    function postDate() {

        const d = new Date();

        return (
            d.getDate() +
            "." +
            (d.getMonth() + 1) +
            "." +
            d.getFullYear()
        );

    }

    function loadAndPrintDocument() {

        if (currentDocIndex >= students.length) {

            alert("No more documents to print.");
            return;

        }

        const student = students[currentDocIndex];

        // =========================
        // CLASS EXTRACTION
        // =========================

        let classValue;

        const subject = student.subject;

        if (/lower\s*nursery/i.test(subject)) {

            classValue = "Lower Nursery";

        }
        else if (/upper\s*nursery/i.test(subject)) {

            classValue = "Upper Nursery";

        }
        else if (/kg/i.test(subject)) {

            classValue = "KG";

        }
        else {

            const numMatch =
                subject.match(/(\d+)/);

            classValue =
                numMatch ? numMatch[0] : "N/A";

        }

        // =========================
        // SUBJECT NAME
        // =========================

        const subjectName = subject
            .replace(/[0-9]/g, "")
            .replace(/lower\s*nursery/gi, "")
            .replace(/upper\s*nursery/gi, "")
            .replace(/kg/gi, "")
            .trim();

        // =========================
        // DISTRICT
        // =========================

        const district = student.district;

        const formattedDistrict =
            district.charAt(0).toUpperCase() +
            district.slice(1).toLowerCase();

        // =========================
        // MARKS
        // =========================

        let p = student.marks;

        // =========================
        // LOAD FIELDS
        // =========================

        document.getElementById('text-content1').textContent =
            student.name;

        document.getElementById('text-content2').textContent =
            student.guard_name;

        document.getElementById('text-content3').textContent =
            classValue;

        document.getElementById('text-content4').textContent =
            student.roll;

        document.getElementById('text-content5').textContent =
            student.school_name;

        document.getElementById('text-content6').textContent =
            "Talent Search " +
            subjectName +
            " Olympiad, Class " +
            classValue;

        document.getElementById('text-content7').textContent =
            formattedDistrict +
            ", West Bengal";

        document.getElementById('text-content8').textContent =
            "Student Performance Report (" +
            student.session +
            ")";

        document.getElementById('text-content9').textContent =
            "Total Marks - 100";

        document.getElementById('text-content10').textContent =
            "Marks Scored - " +
            student.marks;

        document.getElementById('text-content11').textContent =
            "Percentile Score - " +
            p +
            "%";

        document.getElementById('text-content12').textContent =
            "Class Rank - " +
            student.subject_school_rank;

        document.getElementById('text-content13').textContent =
            "State Rank - " +
            student.subject_overall_rank;

        document.getElementById('text-content14').textContent =
            "Date - " +
            postDate();

        document.getElementById('text-content15').textContent =
            "District Rank - " +
            student.subject_school_rank;


        // =========================
        // PRINT
        // =========================

        setTimeout(() => {

            window.print();

            setTimeout(async () => {

                const proceed =
                    await openModal();

                if (proceed) {

                    currentDocIndex++;
                    loadAndPrintDocument();

                }
                else {

                    alert("Printing stopped.");

                }

            }, 500);

        }, 1000);

    }

    // =========================
    // START
    // =========================

    window.onload = function () {

        loadAndPrintDocument();

    };

});
</script>

</body>
</html>